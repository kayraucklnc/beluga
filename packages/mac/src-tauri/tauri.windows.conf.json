{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Beluga",
        "width": 1320,
        "height": 860,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "longDescription": "Beluga for Windows: worktrees per task, Claude you can watch, and friends with their own Claude in the same room.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
