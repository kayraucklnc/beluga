{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beluga",
  "version": "1.5.2",
  "identifier": "io.github.kayraucklnc.beluga",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Beluga",
        "width": 1320,
        "height": 860,
        "minWidth": 860,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 },
        "transparent": true,
        "decorations": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:* ipc: http://ipc.localhost; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; base-uri 'none'; form-action 'none'; object-src 'none'"
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["beluga", "klaud"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBNTczOTFEMDA3MThFNDIKUldSQ2puRUFIVGxYYW1jeXhaT0tISG5CQXh3dWJibUJ0MVMvVm5TWDFNNzN4UXY4OHNHaENwR3kK",
      "endpoints": ["https://github.com/kayraucklnc/beluga/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Every project and the Claude working in it, with friends",
    "longDescription": "Beluga for macOS: the same Beluga as the terminal app — worktrees per task, Claude you can watch, and friends with their own Claude in the same room.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "resources": { "resources/daemon/": "daemon/" },
    "externalBin": ["binaries/node"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "files": { "PlugIns/BelugaWidgets.appex": "../widgets/build/BelugaWidgets.appex" },
      "dmg": {
        "background": "../dmg/background.png",
        "windowSize": { "width": 660, "height": 420 },
        "appPosition": { "x": 190, "y": 205 },
        "applicationFolderPosition": { "x": 470, "y": 205 }
      }
    }
  }
}
