<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Installing an APK the Mac built (the phone still shows its own Install prompt). -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.INTERNET" />

  <!-- Listing installed apps (open by package) needs to see launcher activities on Android 11+. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <!-- The Accessibility service the Mac drives (BLG-150). Exported is required for a11y services;
         Android only binds it after the user turns it on, and only the system may bind it. -->
    <service
      android:name="sh.ratel.beluga.control.BelugaAccessibilityService"
      android:exported="true"
      android:label="Beluga — let your Mac use this phone"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/beluga_accessibility" />
    </service>

    <!-- The "Your Mac is using this phone" notification's Stop button comes back here. -->
    <receiver
      android:name="sh.ratel.beluga.control.ControlActionReceiver"
      android:exported="false" />
  </application>
</manifest>
