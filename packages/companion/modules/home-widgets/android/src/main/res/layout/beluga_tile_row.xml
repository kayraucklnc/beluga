<?xml version="1.0" encoding="utf-8"?>
<!-- A board tile on the Home screen, wide: the number on the left, its points beside it (BLG-361, TileRender.kt). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <ImageView
    android:id="@+id/beluga_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/beluga_widget_card" />
  <ImageView
    android:id="@+id/beluga_wash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/beluga_widget_wash"
    android:visibility="gone" />
  <LinearLayout
    android:id="@+id/beluga_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:id="@+id/beluga_mark"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/beluga_ic_laptop" />
      <TextView
        android:id="@+id/beluga_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="Beluga"
        android:textColor="@color/beluga_widget_text"
        android:textSize="12sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/beluga_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:background="@drawable/beluga_pill_note"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:singleLine="true"
        android:textColor="@color/beluga_widget_text2"
        android:textSize="10sp"
        android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="horizontal">
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.44"
        android:gravity="bottom|start"
        android:orientation="vertical">
      <TextView
        android:id="@+id/beluga_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:text=""
        android:textColor="@color/beluga_widget_text"
        android:textSize="30sp" />
      <LinearLayout
        android:id="@+id/beluga_changes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="start"
        android:orientation="vertical">
        <TextView
          android:id="@+id/beluga_change_good"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/beluga_pill_good"
          android:fontFamily="sans-serif-medium"
          android:paddingHorizontal="6dp"
          android:paddingVertical="2dp"
          android:singleLine="true"
          android:text=""
          android:textColor="@color/beluga_widget_good"
          android:textSize="11sp"
          android:visibility="gone" />
        <TextView
          android:id="@+id/beluga_change_bad"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/beluga_pill_bad"
          android:fontFamily="sans-serif-medium"
          android:paddingHorizontal="6dp"
          android:paddingVertical="2dp"
          android:singleLine="true"
          android:text=""
          android:textColor="@color/beluga_widget_bad"
          android:textSize="11sp"
          android:visibility="gone" />
        <TextView
          android:id="@+id/beluga_change_none"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:textColor="@color/beluga_widget_text3"
          android:textSize="11sp"
          android:visibility="gone" />
        <TextView
          android:id="@+id/beluga_vs"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="3dp"
          android:ellipsize="end"
          android:singleLine="true"
          android:textColor="@color/beluga_widget_text3"
          android:textSize="10sp"
          android:visibility="gone" />
      </LinearLayout>
      <TextView
        android:id="@+id/beluga_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:textColor="@color/beluga_widget_text3"
        android:textSize="10sp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="0.56"
        android:orientation="vertical">
      <ImageView
        android:id="@+id/beluga_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="visible" />
      <LinearLayout
        android:id="@+id/beluga_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
          android:id="@+id/beluga_from"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:singleLine="true"
          android:textColor="@color/beluga_widget_text3"
          android:textSize="10sp" />
        <TextView
          android:id="@+id/beluga_to"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:textColor="@color/beluga_widget_text3"
          android:textSize="10sp" />
      </LinearLayout>
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
