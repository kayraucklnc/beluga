{
  "expo": {
    "name": "Beluga",
    "slug": "beluga-companion",
    "version": "1.0.0",
    "scheme": "beluga",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF8F5",
    "icon": "./assets/icon.png",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "android": {
      "package": "sh.ratel.beluga",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1013"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 20
    },
    "ios": {
      "bundleIdentifier": "sh.ratel.beluga",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": false
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Beluga uses the camera only to scan your Mac's pairing code.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#df946a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos to what you ask your Mac."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "./plugins/loopback-cleartext"
    ]
  }
}
