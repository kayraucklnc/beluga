{
  "name": "klaude",
  "version": "0.2.1",
  "description": "Multiplayer terminal for Claude Code: group chat with friends and everyone's Claude agents over a P2P tunnel.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "klaude": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
    "@resvg/resvg-js": "^2.6.2",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "cloudflared": "^0.7.3",
    "ink": "^8.0.0",
    "jpeg-js": "^0.4.4",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "omggif": "^1.0.10",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.6.5",
    "@types/omggif": "^1.0.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
