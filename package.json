{
  "name": "beluga",
  "private": true,
  "version": "0.6.2",
  "description": "Beluga's engine: what the Mac app (packages/mac) runs in the background. Not published.",
  "homepage": "https://github.com/kayraucklnc/beluga#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kayraucklnc/beluga.git"
  },
  "bugs": {
    "url": "https://github.com/kayraucklnc/beluga/issues"
  },
  "author": "Kayra Uckilinc",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "dev": "tsx src/cli.ts daemon --keep-alive demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
    "@fugood/whisper.node": "1.2.0-rc.1",
    "@hyperswarm/secret-stream": "^6.9.2",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@resvg/resvg-js": "^2.6.2",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "b4a": "^1.9.0",
    "chokidar": "^5.0.0",
    "cloudflared": "^0.7.3",
    "hyperdht": "^6.34.1",
    "jpeg-js": "^0.4.4",
    "mathjax-full": "^3.2.2",
    "omggif": "^1.0.10",
    "pngjs": "^7.0.0",
    "sodium-universal": "^5.0.1",
    "string-width": "^8.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/omggif": "^1.0.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
