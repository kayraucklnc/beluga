{
  "name": "klaudcode",
  "version": "0.4.0",
  "description": "A terminal home for all your projects and the Claude working in them: a worktree per task, sub-agents you can watch, and friends with their own Claude in the same room.",
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "agents",
    "terminal",
    "tui",
    "worktree",
    "git",
    "pair-programming",
    "multiplayer"
  ],
  "homepage": "https://github.com/kayraucklnc/klaud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kayraucklnc/klaud.git"
  },
  "bugs": {
    "url": "https://github.com/kayraucklnc/klaud/issues"
  },
  "author": "Kayra Uckilinc",
  "license": "MIT",
  "type": "module",
  "bin": {
    "klaud": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
    "@hyperswarm/secret-stream": "^6.9.2",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@resvg/resvg-js": "^2.6.2",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "cloudflared": "^0.7.3",
    "hyperdht": "^6.34.1",
    "ink": "^8.0.0",
    "jpeg-js": "^0.4.4",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "omggif": "^1.0.10",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.6.5",
    "@types/omggif": "^1.0.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
